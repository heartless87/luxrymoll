# Enable rewrite
RewriteEngine On

# Explicitly allow POST requests
<LimitExcept GET POST OPTIONS>
  Deny from all
</LimitExcept>

# Ensure PHP handles the file
AddHandler application/x-httpd-php .php

# Disable method blocking by mod_security (if enabled)
<IfModule mod_security.c>
  SecFilterEngine Off
  SecFilterScanPOST Off
</IfModule>
